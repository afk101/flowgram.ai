    "inversify": "^6.0.1",
    "reflect-metadata": "~0.2.2"
  },
  "devDependencies": {
    "@q/flowgram.ai.eslint-config": "workspace:*",
    "@q/flowgram.ai.ts-config": "workspace:*",
    "@types/bezier-js": "4.1.3",
    "@types/lodash": "^4.14.137",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/styled-components": "^5",
    "@vitest/coverage-v8": "^0.32.0",
    "eslint": "^8.54.0",
    "react": "^18",
    "react-dom": "^18",
    "styled-components": "^5",
    "tsup": "^8.0.1",
    "typescript": "^5.8.3",
    "vitest": "^0.34.6"
  },
